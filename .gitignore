# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
maplibrex-*.tar

# Temporary files, for example, from tests.
/tmp/

# Node.js dependencies
/assets/node_modules/

# The built hook bundle IS committed. It is what applications using
# `{:maplibrex, github: ...}` load, since a git dependency has no build step —
# the same reason phoenix and phoenix_live_view commit theirs. `mix ci` fails
# if it ever drifts from the TypeScript sources.
# The sourcemap stays out: `--sourcemap=external` emits no sourceMappingURL
# comment, so nothing looks for it, and it is 250 KB of churn.
/priv/static/assets/js/*.map

# TypeScript build artifacts
/assets/dist/

# Editor and IDE files
.DS_Store
.vscode/
.idea/
*.swp
*.swo
*~

# Environment files
.env
.env.local

# Wallaby screenshots
screenshots/

# NPM debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local agent tooling cache (gentle-ai skill registry).
/.atl/
